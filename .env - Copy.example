# Production origin is hardcoded as https://house-drama.xyz in src/lib/drama/site.ts.
# Do not put a real DATABASE_URL or admin secret in this file or in the ZIP.

# Neon connection string. The Worker uses the HTTP driver, not TCP.
# wrangler secret put DATABASE_URL
DATABASE_URL=

# Already set in wrangler.jsonc. When "1", a missing DATABASE_URL throws
# instead of opening the temporary PGLite database.
HOUSEDRAMA_REQUIRE_DATABASE=1

# Admin console. Generate a long random secret. There is no default password.
# wrangler secret put DRAMA_ADMIN_PASSWORD
# wrangler secret put DRAMA_ADMIN_SECRET
DRAMA_ADMIN_PASSWORD=
DRAMA_ADMIN_SECRET=

# Optional. Leave empty to use the built-in provider hosts.
ANYREEL_API_URL=
DRAMABOX_API_URL=
FREEREELS_API_URL=

# Optional. Used only to refresh the Indonesian title cache. The site works without it.
XAI_API_KEY=
